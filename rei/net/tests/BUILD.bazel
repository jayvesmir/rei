load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//rei:copts.bzl", "CXXOPTS")

cc_library(
    name = "posix_compat",
    strip_include_prefix = "posix_compat",
    testonly = True,

    hdrs = [
        "posix_compat/netinet/in.h",
        "posix_compat/netinet/tcp.h",
        "posix_compat/sys/socket.h",
    ],

    target_compatible_with = ["@platforms//os:windows"],
)

cc_test(
    name = "tests",
    size = "small",

    srcs = [
        "certificates.hpp",
        "http_body.cpp",
        "http_client_server.cpp",
        "http_connection.cpp",
        "http_framing.cpp",
        "http_head.cpp",
        "http_message.cpp",
        "resolve.cpp",
        "socket_lifecycle.cpp",
        "socket_tcp.cpp",
        "socket_timeout.cpp",
        "socket_udp.cpp",
        "support.hpp",
        "tls.cpp",
    ],

    deps = [
        "//rei/net",
        "@googletest//:gtest_main",
    ] + select({
        "@platforms//os:windows": [":posix_compat"],
        "//conditions:default": [],
    }),

    cxxopts = CXXOPTS,
)
