module(
    name = "rei",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "magic_enum", version = "0.9.8")
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.3")
bazel_dep(name = "highway", version = "1.4.0.bcr.1")
bazel_dep(name = "vulkan_headers", version = "1.4.349")
bazel_dep(name = "vulkan_memory_allocator", version = "3.3.0")
bazel_dep(name = "spirv_tools", version = "2026.3")
bazel_dep(name = "spirv_headers", version = "1.4.357.0")

bazel_dep(name = "googletest", version = "1.18.0", dev_dependency = True)
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2", dev_dependency = True)

# The Vulkan SDK's glslc compiles the shaders of the gpu::vk tests and testbed.
bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "rules_vulkan", version = "0.9.0", dev_dependency = True)

vulkan_sdk = use_extension("@rules_vulkan//vulkan:extensions.bzl", "vulkan_sdk", dev_dependency = True)

vulkan_sdk.toolchain(version = "1.4.350.0")
use_repo(vulkan_sdk, "vulkan_sdk_1.4.350.0")

register_toolchains("@vulkan_sdk_1.4.350.0//:all", dev_dependency = True)

# Unicode data for IDNA in core::url.
idna_tables = use_repo_rule("//rei/core:url/idna_tables.bzl", "idna_tables")

idna_tables(
    name = "idna_tables",
    version = "18.0.0",
    sha256 = {
        "idna/IdnaMappingTable.txt": "a03b1eb38032268c696406a83f0972d6a815acd2c8d4151d42ec0fda70ffced1",
        "ucd/UnicodeData.txt": "0736451de439ae7baf1425136617da495e09ee5afbe6e394374db7009ea08950",
        "ucd/DerivedNormalizationProps.txt": "98ac7f67d985fe781e317f6182e885e94cabb0c314769e6dd73e48b226931ccd",
        "ucd/extracted/DerivedBidiClass.txt": "d9e23222522551348ea1ccfbb4f62efbf98982afb95840f8959c08ed992c5607",
        "ucd/extracted/DerivedCombiningClass.txt": "ef6b2611cfb660dba3f6b458b9eb4b05f44ed2417302ee7749d7f0f348793121",
        "ucd/extracted/DerivedGeneralCategory.txt": "d6b151d2d40ee9b1876d26f417980f45ffae47b6055ccf7203cb31f07a030f94",
        "ucd/extracted/DerivedJoiningType.txt": "e2408ff2c92b175b0f7bf62c989bbb54c7b077528fe31f8d69b96fa09e7d61ed",
    },
)

# Vulkan's formats and feature bits for gpu::vk.
vk_vocabulary = use_repo_rule("//rei/gpu:vk/vocabulary.bzl", "vk_vocabulary")

vk_vocabulary(name = "rei_vk_vocabulary")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "idna_test_v2",
    url = "https://www.unicode.org/Public/18.0.0/idna/IdnaTestV2.txt",
    sha256 = "0236b75c5b20dfd857b3b5cf75509887959d6ab00d6c7bda9b7dc3df518c1fde",
    dev_dependency = True,
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# float serialization for formats::json.
http_archive(
    name = "zmij",
    url = "https://github.com/vitaut/zmij/archive/refs/tags/v1.2.tar.gz",
    sha256 = "13e11c9309fab358d5b6f656050e4f3efa1d20ecf15958ae9055382d07b0268f",
    strip_prefix = "zmij-1.2",
    build_file = "//third_party:zmij.bzl"
)

http_archive(
    name = "volk",
    url = "https://github.com/zeux/volk/archive/refs/tags/vulkan-sdk-1.4.350.1.tar.gz",
    sha256 = "078a9411298e4e0f60f5f5398c890783427c25a414619294ca8e69587bbd5eae",
    strip_prefix = "volk-vulkan-sdk-1.4.350.1",
    build_file = "//third_party:volk.bzl",
)

# Shader reflection for gpu::vk.
http_archive(
    name = "spirv_reflect",
    url = "https://github.com/KhronosGroup/SPIRV-Reflect/archive/refs/tags/vulkan-sdk-1.4.350.1.tar.gz",
    sha256 = "e045cdd7598211cdbaf39791151bc526a9844401d615579e4959966d2317bdd7",
    strip_prefix = "SPIRV-Reflect-vulkan-sdk-1.4.350.1",
    build_file = "//third_party:spirv_reflect.bzl",
    patches = ["//third_party/patches:spirv_reflect.patch"],
    patch_strip = 1,
)

# Conformance cases for formats::toml.
http_archive(
    name = "toml_test",
    url = "https://github.com/toml-lang/toml-test/archive/refs/tags/v2.2.0.tar.gz",
    sha256 = "fdab2779b3902eb08030f389a5d53e95c5b49404149ac6f2eda5227a5363c232",
    strip_prefix = "toml-test-2.2.0",
    build_file = "//third_party:toml_tests.bzl",
    dev_dependency = True,
)

# Conformance cases for formats::json.
http_archive(
    name = "json_test",
    url = "https://github.com/nst/JSONTestSuite/archive/1ef36fa01286573e846ac449e8683f8833c5b26a.tar.gz",
    sha256 = "32ab2fb37cc26679dbd9164dbb7053bcef10134643d53cb0cef45de7680dcdcc",
    strip_prefix = "JSONTestSuite-1ef36fa01286573e846ac449e8683f8833c5b26a/test_parsing",
    build_file = "//third_party:json_tests.bzl",
    dev_dependency = True,
)
